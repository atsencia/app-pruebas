# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
ios/
/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem
# Excepción: CA pública (no una llave privada) que el prebuild de Android
# necesita empaquetar. `eas build` sube el proyecto filtrando con estas
# reglas de .gitignore, así que si se ignora acá, EAS Build tampoco la ve
# aunque esté commiteada en git (ENOENT en withVecindadCert.js).
!/certs/vecindad_ca.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

.env
