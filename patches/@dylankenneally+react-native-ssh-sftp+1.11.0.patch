+// ── Patch (app-vecindad): pinning del host key del server SFTP de prod ──
+// La librería original conecta con StrictHostKeyChecking=no — o sea, acepta
+// CUALQUIER servidor sin chequear su identidad (equivalente a no validar el
+// certificado en HTTPS). Este repositorio fija el fingerprint SHA256 real
+// de vecindad.sencia.com.co (obtenido por el equipo con
+// `ssh-keyscan -p 9022 vecindad.sencia.com.co` en el propio servidor) y
+// rechaza cualquier otra llave.
+//
+// Si el server rota su host key, hay que actualizar PINNED_HOST_KEY_SHA256
+// acá (y en cualquier futuro parche generado con patch-package).
+class PinnedHostKeyRepository implements HostKeyRepository {
+  private static final String PINNED_HOST_KEY_SHA256 = "nNygaeJQ4ootb2nYo2I1EJlp91aptK+yx3c8hXlw400";
+
+  private String sha256Fingerprint(byte[] key) {
+    try {
+      MessageDigest md = MessageDigest.getInstance("SHA-256");
+      byte[] hash = md.digest(key);
+      return Base64.encodeToString(hash, Base64.NO_WRAP | Base64.NO_PADDING);
+    } catch (Exception e) {
+      return null;
+    }
+  }
+
+  @Override
+  public int check(String host, byte[] key) {
+    String fingerprint = sha256Fingerprint(key);
+    if (fingerprint != null && fingerprint.equals(PINNED_HOST_KEY_SHA256)) {
+      return HostKeyRepository.OK;
+    }
+    // NOT_INCLUDED (no CHANGED) porque no tenemos un known_hosts real detrás,
+    // pero con StrictHostKeyChecking=yes cualquier resultado != OK aborta la
+    // conexión igual — el efecto práctico es el mismo rechazo.
+    return HostKeyRepository.NOT_INCLUDED;
+  }
+
+  @Override
+  public void add(HostKey hostkey, UserInfo ui) {
+    // No-op a propósito: no persistimos llaves nuevas, solo se acepta la pineada.
+  }
+
+  @Override
+  public void remove(String host, String type) {}
+
+  @Override
+  public void remove(String host, String type, byte[] key) {}
+
+  @Override
+  public String getKnownHostsRepositoryID() {
+    return "vecindad-pinned-host-key";
+  }
+
+  @Override
+  public HostKey[] getHostKey() {
+    return new HostKey[0];
+  }
+
+  @Override
+  public HostKey[] getHostKey(String host, String type) {
+    return new HostKey[0];
+  }
+}
